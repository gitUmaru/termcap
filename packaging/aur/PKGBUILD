# Maintainer: Umar Ali <29158525+gitUmaru@users.noreply.github.com>
pkgname=termcap
pkgver=0.1.0
pkgrel=1
pkgdesc="Record your terminal and export to text, SVG, GIF, PNG, JPEG, or MP4"
arch=('any')
url="https://github.com/gitUmaru/termcap"
license=('MIT')
depends=(
  'python'
  'python-pillow'
  'python-fonttools'
)
optdepends=('ffmpeg: MP4 and WebM video output, and frame extraction')
makedepends=(
  'python-build'
  'python-installer'
  'python-wheel'
  'python-setuptools'
)
source=("$pkgname-$pkgver.tar.gz::https://github.com/gitUmaru/termcap/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
